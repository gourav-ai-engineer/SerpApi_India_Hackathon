# Create a free SerpApi account and copy your key here for live searches.
# Never commit a real key or paste it into a public issue or README.
SERPAPI_API_KEY=your_serpapi_key_here

# Optional: Gemini can suggest validated search-query variants.
# Leave the key empty to use the built-in rule-based planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: change the default local SQLite database path.
# CAREERPILOT_DB=data/careerpilot.db
